# Copy file nay thanh .env va thieu gia tri theo moi truong
NODE_ENV=development
PORT=3000

# PostgreSQL (khop voi docker-compose.yml)
DATABASE_URL=postgresql://innoorder:innoorder_dev@127.0.0.1:5432/innoorder?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=doi-secret-cay-nay-trong-prod
JWT_EXPIRES_IN=7d

# URL can bang QR cho khach goi mon
# San prod: https://go.innoorder.com  -> QR: {QR_BASE_URL}/s/{store_slug}/t/{table_code}
QR_BASE_URL=http://localhost:3000

# CORS - danh sach domain frontend (phay tach)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3002
